---
import { withBase } from '../lib/site-path.mjs';
// 窄屏抽屉底部：QQ 群、GitHub 与下载入口（与顶栏一致）。
---

<div class="nb-mobile-footer">
  <a class="nb-m-link" href="https://qm.qq.com/q/GMQQF4zSyy" target="_blank" rel="noopener">QQ 群</a>
  <a class="nb-m-link" href="https://github.com/UCKETX/NEMCBridge" target="_blank" rel="noopener">GitHub</a>
  <a class="nb-m-dl" href={withBase('/#download')}>下载</a>
</div>

<style>
  .nb-mobile-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .nb-m-link {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .nb-m-dl {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    background: linear-gradient(180deg, #bb86ff 0%, #9346f5 55%, #7c2fe6 100%);
    box-shadow: inset 0 3px 0 rgba(255, 255, 255, 0.28), inset 0 -4px 0 rgba(40, 0, 90, 0.45);
    clip-path: polygon(0 4px, 4px 4px, 4px 0, calc(100% - 4px) 0, calc(100% - 4px) 4px, 100% 4px, 100% calc(100% - 4px), calc(100% - 4px) calc(100% - 4px), calc(100% - 4px) 100%, 4px 100%, 4px calc(100% - 4px), 0 calc(100% - 4px));
  }
</style>
